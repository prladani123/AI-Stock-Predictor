# REQUIRED LOCAL STACK
POSTGRES_DB=banknifty
POSTGRES_USER=banknifty
POSTGRES_PASSWORD=replace-with-a-long-local-password
APP_SECRET=replace-with-a-long-symfony-secret
INTERNAL_API_TOKEN=replace-with-a-long-internal-token
# Host CLI only; Compose constructs its container DATABASE_URL from POSTGRES_*.
DATABASE_URL=postgresql://banknifty:replace-with-a-long-local-password@127.0.0.1:5432/banknifty

# OPTIONAL REAL MARKET DATA
HISTORICAL_REQUESTS_PER_SECOND=3
HISTORICAL_CHUNK_DAYS=60
HISTORICAL_MAX_RETRIES=3
ALLOW_REAL_ZERODHA=false
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=
LIVE_LATENESS_SECONDS=3
LIVE_STALE_SECONDS=10
LIVE_QUEUE_LIMIT=2048
LIVE_OPTION_STRIKE_WIDTH=5
LIVE_MARKET_ENABLED=false
LIVE_UNIVERSE_REFRESH_SECONDS=300
RAW_TICK_RETENTION_DAYS=14

# BIG MOVE RUNTIME — approved V2 artifacts required
BIG_MOVE_RUNTIME_ENABLED=false
BIG_MOVE_RUNTIME_INTERVAL_SECONDS=15

# NEWS
NEWS_POLLING_ENABLED=true
NEWS_REACTION_INTERVAL_SECONDS=30
NEWS_POLL_INTERVAL_SECONDS=90
NEWS_SOURCE_NSE_OFFICIAL_ENABLED=true
NEWS_SOURCE_RBI_OFFICIAL_ENABLED=true
NEWS_SOURCE_MONEYCONTROL_ENABLED=true
NEWS_SOURCE_ET_MARKETS_ENABLED=true
NEWS_SOURCE_LIVEMINT_ENABLED=true

# MEMORY
MEMORY_ROLLUP_ENABLED=true
MEMORY_ROLLUP_AFTER=15:45

# RESEARCH
ML_THREADS=2
ML_RANDOM_SEED=1729
EVIDENCE_MINIMUM_SAMPLE=20

# OPTIONAL EXTERNAL RESEARCH — never used by PRICE_CORE_V2
# Start the CPU sidecar with: docker compose --profile research up -d
KRONOS_RESEARCH_ENABLED=false
KRONOS_SERVICE_URL=http://kronos-research:8010
KRONOS_SAMPLE_PATHS=8
KRONOS_SEED=1729
KRONOS_TIMEOUT_SECONDS=90
TIME_MACHINE_ENABLED=false
# Required accepted historical revision used only as the replay pool.
TIME_MACHINE_REPLAY_POOL_REVISION_ID=
TIME_MACHINE_PATHS=10000
TIME_MACHINE_SLOT_WINDOW_MINUTES=2
TIME_MACHINE_MIN_PRIOR_SESSIONS=20
TIME_MACHINE_SEED=1729

# OPTIONAL RESEARCH DATA — UPSTOX (does not replace Zerodha live collection)
UPSTOX_ANALYTICS_ENABLED=false
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_PLUS_EXPIRED_DATA_ENABLED=false
# Optional official Global Instruments JSON/JSON.gz file; includes USDINR identity and source latency.
# For Compose, use a path inside /app/market_memory (the existing bind mount).
UPSTOX_GLOBAL_INSTRUMENTS_FILE=
UPSTOX_BOD_INSTRUMENTS_FILE=
NEWS_SOURCE_UPSTOX_INSTRUMENT_ENABLED=false
MARKET_STRUCTURE_CONTEXT_ENABLED=false
MARKET_STRUCTURE_CONTEXT_INTERVAL_SECONDS=60
EVENT_IMPACT_MINIMUM_SAMPLE=5

# OPTIONAL RESEARCH DATA — DHAN (monthly BANKNIFTY research; no weekly requests)
DHAN_RESEARCH_ENABLED=false
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_DATA_API_ENABLED=false

# RESEARCH CONTEXT — historical enrichment is explicit; optional runtime polling is separately gated
RESEARCH_CONTEXT_PROVIDER=auto
RESEARCH_CONTEXT_OPTION_WIDTH=10
RESEARCH_CONTEXT_STALENESS_POLICY_VERSION=context-staleness-v1
RESEARCH_CONTEXT_STALENESS_SECONDS={"BANKNIFTY":120,"INDIA_VIX":180,"GIFT_NIFTY":300,"BRENT":900,"USDINR":900,"OPTIONS":120,"MARKET_INFORMATION":3600}

# LEGACY_DIRECTION_BASELINE_V1 — not Big Move V2 runtime decision thresholds
LABEL_THRESHOLD_POLICY_VERSION=fixed-v1
LABEL_THRESHOLD_5_MIN=0.0010
LABEL_THRESHOLD_10_MIN=0.0015
LABEL_THRESHOLD_15_MIN=0.0020
LABEL_THRESHOLD_20_MIN=0.0025
