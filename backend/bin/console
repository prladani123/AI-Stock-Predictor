#!/usr/bin/env php
<?php
use App\Kernel;
use Symfony\Bundle\FrameworkBundle\Console\Application;
if (!is_dir(dirname(__DIR__).'/vendor')) { throw new LogicException('Run composer install first.'); }
$_SERVER['APP_RUNTIME_OPTIONS']['disable_dotenv'] = !is_file(dirname(__DIR__).'/.env');
require_once dirname(__DIR__).'/vendor/autoload_runtime.php';
return static function (array $context): Application { return new Application(new Kernel($context['APP_ENV'], (bool) $context['APP_DEBUG'])); };
